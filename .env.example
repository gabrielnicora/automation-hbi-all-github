# Configuración de ejecución. Los usuarios se leen desde test-data/private/bersa.json.
# qa: BERSA QA (por defecto) | une-dev: UNE DEV, contraseña y OTP de test-data/private/une-dev.json.
TEST_ENV=qa

# Opcionales. Cada ambiente posee valores predeterminados.
UI_BASE_URL=
API_BASE_URL=

# La ejecución es secuencial porque algunos canales reutilizan la misma identidad.
PW_WORKERS=1

# Reintentos de escenarios fallidos en local y CI: 1 por defecto; 0 los desactiva.
PW_RETRIES=1

# Opcional: chrome | msedge
PW_BROWSER_CHANNEL=
